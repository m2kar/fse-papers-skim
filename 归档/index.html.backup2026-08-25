<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FSE 论文略读</title>
<style>
:root{
  --bg:#F6F5F1; --card:#FFFFFF; --ink:#1F2328; --muted:#6B7280; --line:#E6E3DA;
  --shadow:0 1px 3px rgba(20,22,26,.06),0 4px 14px rgba(20,22,26,.05);
  --serif:"Noto Serif SC","Songti SC","STSong","SimSun",serif;
  --sans:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Segoe UI",sans-serif;
}
html[data-theme="dark"]{
  --bg:#141619; --card:#1E2126; --ink:#E8E6E0; --muted:#98A0A8; --line:#2B2F36;
  --shadow:0 1px 3px rgba(0,0,0,.35),0 6px 18px rgba(0,0,0,.3);
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0; background:var(--bg); color:var(--ink); font-family:var(--sans);
  display:flex; flex-direction:column; overflow:hidden;
}
button{font-family:var(--sans); cursor:pointer}
@keyframes fadein{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
body.booting #foot, body.booting #controls{display:none}

/* ---------- 加载 / 错误 ---------- */
.boot{position:absolute; inset:0; display:flex; flex-direction:column;
  align-items:center; justify-content:center; gap:16px; text-align:center; padding:40px}
.boot .ring{width:34px; height:34px; border-radius:50%;
  border:3px solid var(--line); border-top-color:#3B5BDB; animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.boot .msg{color:var(--muted); font-size:16px}
.boot.error .ring{display:none}
.boot.error .msg{color:#E03131; font-size:16px; line-height:1.8; max-width:560px}
.boot code{background:var(--card); border:1px solid var(--line); border-radius:6px; padding:2px 8px; font-size:14px}

/* ---------- 舞台 ---------- */
#stage{flex:1; min-height:0; position:relative}
.slide{
  position:absolute; inset:0; padding:24px 56px 16px;
  display:flex; flex-direction:column; overflow:hidden;
  animation:fadein .18s ease; user-select:none;
}

/* ---------- 论文页 ---------- */
.prow{display:flex; align-items:center; gap:14px; flex-wrap:wrap}
.badge{
  display:inline-flex; align-items:center; gap:9px;
  background:color-mix(in srgb, var(--cat) 10%, var(--card));
  color:var(--cat); border:1px solid color-mix(in srgb, var(--cat) 35%, transparent);
  padding:4px 14px 4px 5px; border-radius:999px; font-size:15px; font-weight:600;
}
.badge .mn{
  display:inline-flex; width:24px; height:24px; align-items:center; justify-content:center;
  background:var(--cat); color:#fff; border-radius:999px; font-size:14px; font-weight:700;
}
.pos{font-size:14.5px; color:var(--muted); font-variant-numeric:tabular-nums}
.tzh{
  font-family:var(--serif); font-weight:700;
  font-size:clamp(26px, 3.1vw, 42px); line-height:1.28;
  margin:14px 0 6px; letter-spacing:.01em;
}
.ten{
  font-size:clamp(13px, 1.25vw, 17px); color:var(--muted); line-height:1.45; margin-bottom:10px;
  display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
}
.summary{
  padding:9px 16px;
  border-left:4px solid var(--cat); border-radius:6px;
  background:color-mix(in srgb, var(--cat) 7%, var(--card));
  font-size:clamp(14.5px, 1.5vw, 20px); line-height:1.55; font-weight:500;
}
.cols{flex:1; min-height:0; display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:16px}
.col{
  background:var(--card); border:1px solid var(--line); border-top:4px solid var(--ca);
  border-radius:10px; padding:14px 18px 12px; box-shadow:var(--shadow);
  display:flex; flex-direction:column; min-height:0; overflow:hidden;
}
.col header{
  font-size:clamp(15px, 1.5vw, 19px); font-weight:700; color:var(--ca);
  margin-bottom:9px; display:flex; align-items:center; gap:8px; flex:none;
}
.col header .ic{font-size:1.05em}
.col p{margin:0; font-size:clamp(14px, 1.5vw, 20px); line-height:1.62; overflow:hidden}
.col p.md{font-size:clamp(13.5px, 1.35vw, 18.5px); line-height:1.58}
.col p.sm{font-size:clamp(13px, 1.25vw, 17px); line-height:1.55}
.col p.xs{font-size:clamp(12px, 1.15vw, 15.5px); line-height:1.5}
.c-problem{--ca:#D9480F} .c-method{--ca:#1971C2} .c-effect{--ca:#2F9E44}

/* 团队行 + 展开按钮（三列卡片与详情之间） */
.bottomRow{flex:none; display:flex; justify-content:space-between; align-items:center;
  gap:18px; margin-top:14px}
.team{flex:1; min-width:0; font-size:clamp(13px, 1.3vw, 17px); color:var(--ink); opacity:.85; line-height:1.5;
  display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden}
.expand{
  flex:none; padding:6px 22px;
  background:transparent; color:var(--muted);
  border:1px dashed color-mix(in srgb, var(--muted) 45%, transparent); border-radius:999px;
  font-size:13.5px;
}
.expand:hover{color:var(--cat); border-color:var(--cat)}

/* ---------- 类别页 ---------- */
.cat .wm{
  position:absolute; right:2vw; bottom:-8vh; z-index:0;
  font-family:var(--serif); font-size:52vh; line-height:1;
  color:var(--cat); opacity:.08; pointer-events:none;
}
.catbody{position:relative; z-index:1; margin:auto 0; max-width:1080px}
.catmeta{color:var(--cat); font-weight:700; letter-spacing:.06em; font-size:15px}
.catbody h1{font-family:var(--serif); font-size:clamp(28px,3.6vw,46px); margin:12px 0 16px; line-height:1.2}
.survey{
  margin:0; max-width:1040px;
  font-family:var(--serif);
  font-size:clamp(14.5px, 1.75vw, 21px); line-height:1.9; text-align:justify;
}
.survey .cite{color:var(--cat); font-weight:600; font-family:var(--sans); font-size:.9em}
.plist{margin-top:22px; display:flex; flex-wrap:wrap; gap:8px; max-width:1020px}
.pchip{
  font-size:13px; padding:5px 10px; border-radius:6px;
  border:1px solid var(--line); background:var(--card); color:var(--muted);
  line-height:1.4;
}
.pchip b{color:var(--cat); margin-right:6px; font-weight:700}

/* ---------- 封面 / 结尾 ---------- */
.cover,.end{align-items:center; justify-content:center; text-align:center}
.coverKick{color:var(--muted); font-size:16px; letter-spacing:.35em; margin-bottom:14px}
.coverTitle{font-family:var(--serif); font-size:clamp(40px,6vw,72px); margin:0 0 8px; font-weight:700}
.coverSub{color:var(--muted); font-size:clamp(15px,1.6vw,20px); margin-bottom:34px}
.cchips{display:grid; grid-template-columns:repeat(6,1fr); gap:12px; width:min(980px,86vw)}
.cchip{
  background:var(--card); border:1px solid var(--line); border-top:4px solid var(--sc);
  border-radius:10px; padding:14px 6px 12px; box-shadow:var(--shadow); color:var(--ink);
}
.cchip:hover{transform:translateY(-3px); transition:transform .15s}
.cchip .mc{font-family:var(--serif); font-size:30px; font-weight:700; color:var(--sc); display:block}
.cchip .nm{display:block; font-size:13px; margin-top:6px; line-height:1.35}
.cchip .ct{display:block; font-size:12px; color:var(--muted); margin-top:4px}
.hint{position:absolute; bottom:20px; left:0; right:0; text-align:center; color:var(--muted); font-size:13.5px}
.hint b{color:var(--ink); background:var(--card); border:1px solid var(--line); border-radius:5px; padding:1px 7px; font-weight:600; font-size:12.5px}
.endTitle{font-family:var(--serif); font-size:clamp(34px,4.5vw,58px); margin:0 0 12px}
.endSub{color:var(--muted); font-size:clamp(15px,1.6vw,19px)}

/* ---------- 顶部全局控件 ---------- */
#controls{position:fixed; top:14px; right:18px; display:flex; gap:8px; z-index:70}
#controls button{
  height:32px; padding:0 12px; border-radius:8px; font-size:13px;
  background:color-mix(in srgb, var(--card) 82%, transparent); color:var(--muted);
  border:1px solid var(--line); backdrop-filter:blur(4px);
}
#controls button:hover{color:var(--ink); border-color:var(--muted)}

/* ---------- 底栏 ---------- */
#foot{
  flex:none; height:52px; display:flex; align-items:center; gap:18px;
  padding:0 22px; background:var(--card); border-top:1px solid var(--line); z-index:40;
}
#pbar{flex:1; display:flex; gap:3px; height:8px; min-width:120px}
.seg{position:relative; flex:1; border-radius:4px; overflow:hidden;
  background:color-mix(in srgb, var(--sc) 16%, transparent)}
.seg i{position:absolute; inset:0; width:0%; background:var(--sc); opacity:.9; transition:width .2s}
#fmeta{font-size:13px; color:var(--muted); white-space:nowrap; font-variant-numeric:tabular-nums}
#tchip{font-size:13px; color:var(--ink); background:var(--bg); border:1px solid var(--line);
  border-radius:999px; padding:3px 10px; font-variant-numeric:tabular-nums}
#foot .arrs{display:flex; gap:8px}
#foot .arrs button{
  width:34px; height:34px; border-radius:8px; font-size:16px;
  background:var(--bg); color:var(--ink); border:1px solid var(--line);
}
#foot .arrs button:hover:not(:disabled){border-color:var(--muted)}
#foot .arrs button:disabled{opacity:.35; cursor:default}

/* ---------- 详情抽屉 ---------- */
#drawer{
  position:fixed; left:0; right:0; bottom:0; height:76vh; z-index:80;
  background:var(--card); border-top:3px solid var(--cat,#5C5F66);
  box-shadow:0 -14px 44px rgba(0,0,0,.28);
  transform:translateY(103%); transition:transform .28s ease;
  display:flex; flex-direction:column; padding:14px 30px 18px;
}
#drawer.open{transform:none}
.dhead{display:flex; justify-content:space-between; align-items:center; flex:none}
.dhead h2{margin:0; font-size:17px; font-weight:700}
.dhead h2 .no{color:var(--cat)}
#dClose{background:transparent; border:1px solid var(--line); color:var(--muted);
  border-radius:8px; padding:5px 14px; font-size:13px}
#dClose:focus{outline:none; border-color:var(--muted)}
#dClose:hover{color:var(--ink); border-color:var(--muted)}
.dmeta{margin-top:8px; font-size:13.5px; color:var(--muted); line-height:1.6; flex:none}
.dmeta b{color:var(--ink); font-weight:600; margin-right:6px}
.dkw{margin-top:7px; display:flex; flex-wrap:wrap; gap:6px; flex:none}
.dkw span{font-size:12px; padding:2px 9px; border-radius:999px;
  background:color-mix(in srgb, var(--cat) 9%, transparent); color:var(--cat)}
.dgrid{flex:1; min-height:0; display:grid; grid-template-columns:41% 1fr; gap:16px; margin-top:12px}
.dabs{display:flex; flex-direction:column; min-height:0; border:1px solid var(--line); border-radius:10px; overflow:hidden}
.dtabs{display:flex; gap:8px; padding:10px 12px 0; flex:none}
.dtabs button{border:1px solid var(--line); background:transparent; color:var(--muted);
  border-radius:8px 8px 0 0; padding:6px 16px; font-size:13.5px; border-bottom:none}
.dtabs button.on{background:var(--cat); border-color:var(--cat); color:#fff; font-weight:600}
.dabsbody{flex:1; overflow:auto; padding:12px 16px; font-size:15.5px; line-height:1.78; user-select:text}
.dpdf{display:flex; flex-direction:column; min-height:0; border:1px solid var(--line); border-radius:10px; overflow:hidden}
.dpdfhead{display:flex; justify-content:space-between; align-items:center;
  padding:7px 14px; border-bottom:1px solid var(--line); font-size:13.5px; flex:none}
.dpdfhead a{color:var(--cat); text-decoration:none; font-weight:600}
#dframe{flex:1; width:100%; border:0; background:#fff}

/* ---------- 目录总览 ---------- */
#ov{position:fixed; inset:0; z-index:90; overflow:auto; padding:22px 48px 30px;
  background:color-mix(in srgb, var(--bg) 94%, transparent); backdrop-filter:blur(6px); display:none}
#ov.open{display:block}
.ovhead{display:flex; justify-content:space-between; align-items:center; margin-bottom:16px}
.ovhead h2{margin:0; font-size:20px}
.ovhead button{background:transparent; border:1px solid var(--line); color:var(--muted);
  border-radius:8px; padding:6px 16px; font-size:13.5px}
.ovg{margin-bottom:20px}
.ovgh{display:flex; align-items:baseline; gap:10px; margin-bottom:9px; cursor:pointer}
.ovgh .mc{font-family:var(--serif); font-size:22px; font-weight:700; color:var(--sc)}
.ovgh .nm{font-size:16px; font-weight:700}
.ovgh .rng{font-size:12.5px; color:var(--muted)}
.ovgrid{display:grid; grid-template-columns:repeat(auto-fill,minmax(232px,1fr)); gap:9px}
.ovcard{background:var(--card); border:1px solid var(--line); border-left:4px solid var(--sc);
  border-radius:8px; padding:9px 12px; cursor:pointer}
.ovcard:hover{transform:translateY(-2px); transition:transform .12s}
.ovcard.cur{outline:2px solid var(--sc)}
.ovcard .n{font-size:12px; color:var(--sc); font-weight:700}
.ovcard .t{font-size:13.8px; line-height:1.45; margin-top:2px;
  display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden}

@media (max-width:900px){
  .slide{padding:18px 22px 12px}
  .cols{gap:10px}
  .cchips{grid-template-columns:repeat(3,1fr)}
  .dgrid{grid-template-columns:1fr; grid-template-rows:38% 1fr}
}
</style>
</head>
<body class="booting">
  <div id="stage"><div class="boot"><div class="ring"></div><div class="msg">正在加载 papers.csv …</div></div></div>

  <div id="controls">
    <button id="btnOv" title="目录总览（G）">☰ 目录</button>
    <button id="btnTheme" title="深浅色切换">🌙 深色</button>
    <button id="btnFs" title="全屏（F）">⛶ 全屏</button>
  </div>

  <footer id="foot">
    <div id="pbar"></div>
    <span id="fmeta"></span>
    <span id="tchip" hidden>⏱ 00:00</span>
    <div class="arrs">
      <button id="btnPrev" title="上一篇（←）">‹</button>
      <button id="btnNext" title="下一篇（→）">›</button>
    </div>
  </footer>

  <aside id="drawer">
    <div class="dhead">
      <h2><span class="no" id="dNo"></span> <span id="dTitle"></span></h2>
