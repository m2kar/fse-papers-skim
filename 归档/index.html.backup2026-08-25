  <div id="ov">
    <div class="ovhead">
      <h2>目录总览 · 点击跳转</h2>
      <button id="ovClose">关闭（Esc / G）</button>
    </div>
    <div id="ovBody"></div>
  </div>

<script>
(function(){
"use strict";
const $ = id => document.getElementById(id);
const esc = s => String(s == null ? "" : s)
  .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
const trunc = (s, n) => s.length > n ? s.slice(0, n) + "…" : s;
const pdfUrl = p => p.split("/").map(encodeURIComponent).join("/");

/* ---------- CSV 解析（带引号、转义、跨行字段） ---------- */
function parseCSV(text){
  text = text.replace(/^\uFEFF/, "");
  const rows = []; let row = [], field = "", i = 0, q = false;
  while (i < text.length){
    const ch = text[i];
    if (q){
      if (ch === '"'){
        if (text[i + 1] === '"'){ field += '"'; i += 2; } else { q = false; i++; }
      } else { field += ch; i++; }
      continue;
    }
    if (ch === '"'){ q = true; i++; continue; }
    if (ch === ","){ row.push(field); field = ""; i++; continue; }
    if (ch === "\n"){
      row.push(field); field = "";
      if (row.some(c => c !== "")) rows.push(row);
      row = []; i++; continue;
    }
    if (ch === "\r"){ i++; continue; }
    field += ch; i++;
  }
  if (field !== "" || row.length){ row.push(field); if (row.some(c => c !== "")) rows.push(row); }
  const head = rows.shift() || [];
  return rows.map(r => {
    const o = {};
    head.forEach((h, k) => o[h.trim()] = (r[k] != null ? r[k] : "").trim());
    return o;
  });
}

/* ---------- 摘要等字段中 LaTeX 记号清理 ---------- */
function clean(s){
  s = (s || "").trim();
  for (let k = 0; k < 3; k++){
    const before = s;
    s = s
      .replace(/\\(?:textit|emph|textbf|texttt|textrm|mbox|uline)\{([^{}]*)\}/g, "$1")
      .replace(/\$\\sim\$/g, "~")
      .replace(/\$\\times\$/g, "×")
      .replace(/\$\\rightarrow\$/g, "→")
      .replace(/\$\\lambda\$/g, "λ")
      .replace(/\\%/g, "%")
      .replace(/\\&/g, "&")
      .replace(/\\_/g, "_")
      .replace(/\$\\text\{([^{}]*)\}\$/g, "$1");
    if (s === before) break;
  }
  return s;
}

/* ---------- 运行时加载两个 CSV ---------- */
async function fetchCSV(name){
  const res = await fetch(encodeURI(name), { cache: "no-store" });
  if (!res.ok) throw new Error(name + " 加载失败（HTTP " + res.status + "）");
  return parseCSV(await res.text());
}

function bootError(msg){
  $("stage").innerHTML =
    '<div class="boot error"><div class="msg">' + esc(msg) +
    '<br><br>本页面需要在本地服务器下运行：<br><br>双击 <code>启动.command</code>，或在本目录执行<br><br><code>python3 -m http.server 8931</code><br><br>然后访问 <code>http://localhost:8931/index.html</code></div></div>';
}

let CATS = [], PAPERS = [], N = 0;
const CAT_COLORS = {"写":"#3B5BDB","测":"#0C8599","改":"#E8590C","析":"#7048E8","防":"#E03131","研":"#2F9E44"};
const catColor = c => CAT_COLORS[c.mnemonic] || "#5C5F66";

async function load(){
  let paperRows, catRows;
  try { paperRows = await fetchCSV("papers.csv"); }
  catch (e){ bootError("无法读取 papers.csv：" + e.message + "（直接双击打开的 file:// 页面无法读取本地文件）"); return false; }
  try { catRows = await fetchCSV("分类思路.csv"); }
  catch (e){ bootError("无法读取 分类思路.csv：" + e.message); return false; }

  CATS = catRows
    .filter(r => /^\d+$/.test(r["篇数"] || ""))
    .map(r => ({
      mnemonic: clean(r["定位口诀"]),
      name: clean(r["分类"]),
      range: clean(r["顺序范围"]),
      count: +r["篇数"],
      survey: clean(r["类别综述"]),
    }));
  const catIndex = {};
  CATS.forEach((c, i) => catIndex[c.name] = i);

  PAPERS = paperRows.map((r, idx) => ({
    order: +clean(r["顺序"]) || idx + 1,
    cat: catIndex[clean(r["分类"])] ?? -1,
    no: clean(r["编号"]),
    noPad: clean(r["编号"]).padStart(2, "0"),
    title: clean(r["标题"]),
    titleZh: clean(r["标题翻译"]),
    authors: clean(r["作者列表"]),
    aff: clean(r["单位"]),
    abs: clean(r["摘要"]),
    absZh: clean(r["摘要翻译"]),
    problem: clean(r["问题挑战"]),
    method: clean(r["核心方法"]),
    effect: clean(r["主要效果"]),
    summary: clean(r["一句话总结"]),
    keywords: clean(r["关键词"]).split(/[；;，,]/).filter(Boolean),
    team: clean(r["作者团队简介"]),
    pdf: clean(r["原文PDF"]),
  }));
  N = PAPERS.length;
  if (!N || !CATS.length){ bootError("CSV 解析结果为空，请检查文件内容。"); return false; }
  return true;
}

/* ---------- 幻灯片序列：封面 →（类别页+论文页）×6 → 结尾 ---------- */
let slides = [], catSlideIdx = [], paperSlideIdx = [];
function buildSlides(){
  slides = [{t:"cover"}];
  catSlideIdx = []; paperSlideIdx = [];
  CATS.forEach((c, ci) => {
    catSlideIdx.push(slides.length);
    slides.push({t:"cat", ci});
    PAPERS.forEach((p, pi) => {
      if (p.cat !== ci) return;
      paperSlideIdx[pi] = slides.length;
      slides.push({t:"paper", pi});
    });
  });
  slides.push({t:"end"});
}
const catStart = ci => CATS.slice(0, ci).reduce((a, c) => a + c.count, 0);

/* ---------- 状态 ---------- */
let cur = 0, drawerOpen = false, curPi = -1;
let tRun = false, tSec = 0, tInt = null;

/* ---------- 渲染 ---------- */
function render(){
  const s = slides[cur];
  const stage = $("stage");
  stage.innerHTML = "";
  const el = document.createElement("div");
  if (s.t === "cover") renderCover(el);
  else if (s.t === "cat") renderCat(el, s.ci);
  else if (s.t === "paper") renderPaper(el, s.pi);
  else renderEnd(el);
  stage.appendChild(el);
  if (s.t === "paper") curPi = s.pi; else curPi = -1;
  if (s.t !== "paper" && drawerOpen) closeDrawer();
  else if (s.t === "paper" && drawerOpen) fillDrawer(s.pi);
  updateFooter();
  $("btnPrev").disabled = cur === 0;
  $("btnNext").disabled = cur === slides.length - 1;
}

function renderCover(el){
  el.className = "slide cover";
  const chips = CATS.map((c, i) =>
    `<button class="cchip" style="--sc:${catColor(c)}" data-goto="${catSlideIdx[i]}">
       <span class="mc">${esc(c.mnemonic)}</span>
       <span class="nm">${esc(c.name)}</span>
       <span class="ct">${c.count} 篇 · 第 ${esc(c.range)} 篇</span>
     </button>`).join("");
  el.innerHTML = `
    <div class="coverKick">组 会 分 享</div>
    <h1 class="coverTitle">FSE 论文略读</h1>
    <div class="coverSub">${N} 篇 · ${CATS.length} 大类 · 每篇约 30 秒</div>
    <div class="cchips">${chips}</div>
    <div class="hint">
      <b>→</b> 下一篇&nbsp;&nbsp;<b>D</b> 详情&nbsp;&nbsp;<b>G</b> 目录&nbsp;&nbsp;<b>1-6</b> 跳类别&nbsp;&nbsp;<b>F</b> 全屏&nbsp;&nbsp;<b>T</b> 计时&nbsp;&nbsp;（点击左右半屏也可翻页）
    </div>`;
}

function renderCat(el, ci){
  const c = CATS[ci];
  el.className = "slide cat";
  el.style.setProperty("--cat", catColor(c));
  const chips = PAPERS.filter(p => p.cat === ci).map(p =>
    `<span class="pchip"><b>#${p.noPad}</b>${esc(trunc(p.titleZh, 22))}</span>`).join("");
  el.innerHTML = `
    <div class="wm">${esc(c.mnemonic)}</div>
    <div class="catbody">
      <div class="catmeta">${esc(c.mnemonic)} · 第 ${esc(c.range)} 篇 · 共 ${c.count} 篇</div>
      <h1>${esc(c.name)}</h1>
      <p class="survey">${esc(c.survey).replace(/#(\d{2,3})/g, '<b class="cite">#$1</b>')}</p>
      <div class="plist">${chips}</div>
    </div>`;
}

function renderPaper(el, pi){
  const p = PAPERS[pi], c = CATS[p.cat];
  el.className = "slide paper";
  el.style.setProperty("--cat", catColor(c));
  el.innerHTML = `
    <div class="prow">
      <span class="badge"><span class="mn">${esc(c.mnemonic)}</span>${esc(c.name)}</span>
      <span class="pos">#${p.noPad} · 第 ${p.order} / ${N} 篇</span>
    </div>
    <h1 class="tzh">${esc(p.titleZh)}</h1>
    <div class="ten">${esc(p.title)}</div>
    <div class="summary">${esc(p.summary)}</div>
    <div class="cols">
      <section class="col c-problem"><header><span class="ic">❓</span>问题挑战</header><p>${esc(p.problem)}</p></section>
      <section class="col c-method"><header><span class="ic">🛠️</span>核心方法</header><p>${esc(p.method)}</p></section>
      <section class="col c-effect"><header><span class="ic">📈</span>主要效果</header><p>${esc(p.effect)}</p></section>
    </div>
    <div class="bottomRow">
      <div class="team">👥 ${esc(p.team)}</div>
      <button class="expand">▸ 展开详情：作者单位 · 中英摘要 · PDF 原文（按 D）</button>
    </div>`;
  el.querySelectorAll(".col p").forEach(pEl => {
    const n = pEl.textContent.length;
    if (n > 230) pEl.classList.add("xs");
    else if (n > 170) pEl.classList.add("sm");
    else if (n > 115) pEl.classList.add("md");
  });
  el.querySelector(".expand").addEventListener("click", () => openDrawer());
  document.title = `#${p.noPad} ${p.titleZh} · FSE 论文略读`;
}

function renderEnd(el){
  el.className = "slide end";
  el.innerHTML = `
    <div class="endTitle">✅ ${N} 篇全部讲完</div>
    <div class="endSub">欢迎讨论 · 提问<br>按 <b>G</b> 可随时回看任意一篇</div>`;
}

/* ---------- 底栏进度 ---------- */
function initFooter(){
  $("pbar").innerHTML = CATS.map((c, i) =>
    `<div class="seg" style="--sc:${catColor(c)}; flex:${c.count}" data-ci="${i}"><i></i></div>`).join("");
}
function donePapers(){
  const s = slides[cur];
  if (s.t === "paper") return PAPERS[s.pi].order;
  if (s.t === "cat") return catStart(s.ci);
  if (s.t === "end") return N;
  return 0;
}
function updateFooter(){
  const done = donePapers();
  document.querySelectorAll("#pbar .seg").forEach(seg => {
    const ci = +seg.dataset.ci;
    const st = catStart(ci), cnt = CATS[ci].count;
    seg.querySelector("i").style.width = Math.max(0, Math.min(cnt, done - st)) / cnt * 100 + "%";
  });
  $("fmeta").textContent = `第 ${Math.min(done, N)} / ${N} 篇`;
}

/* ---------- 详情抽屉 ---------- */
let drawerPi = -1;
function fillDrawer(pi){
  const p = PAPERS[pi], c = CATS[p.cat];
  drawerPi = pi;
  const dw = $("drawer");
  dw.style.setProperty("--cat", catColor(c));
  $("dNo").textContent = "#" + p.noPad;
  $("dTitle").textContent = p.titleZh;
  $("dAuth").textContent = p.authors;
  $("dAff").textContent = p.aff;
  $("dKw").innerHTML = p.keywords.map(k => `<span>${esc(k)}</span>`).join("");
  setAbsTab("zh");
  const url = pdfUrl(p.pdf);
  $("dOpen").href = url;
  // PDF 查看器加载完成后会把焦点抢进 iframe，加载完成时再把焦点拉回来
  const frame = $("dframe");
  frame.onload = () => {
    frame.onload = null;
    if (drawerOpen) $("dClose").focus({ preventScroll: true });
  };
  frame.src = url;
}
function setAbsTab(t){
  const p = PAPERS[drawerPi];
  if (!p) return;
  $("dAbs").textContent = t === "zh" ? p.absZh : p.abs;
  $("tabZh").classList.toggle("on", t === "zh");
  $("tabEn").classList.toggle("on", t !== "zh");
  $("dAbs").scrollTop = 0;
}
function openDrawer(){
  if (curPi < 0) return;
  fillDrawer(curPi);
  drawerOpen = true;
  $("drawer").classList.add("open");
  // 把焦点放到收起按钮上：防止 PDF iframe 抢走键盘焦点后，按键事件不再到达本页面
  $("dClose").focus({ preventScroll: true });
}
function closeDrawer(){
  drawerOpen = false;
  $("drawer").classList.remove("open");
  $("dframe").src = "about:blank";
}
function toggleDrawer(){ drawerOpen ? closeDrawer() : openDrawer(); }

/* ---------- 目录总览 ---------- */
function buildOv(){
  $("ovBody").innerHTML = CATS.map((c, ci) => {
    const cards = PAPERS.map((p, pi) => ({p, pi}))
      .filter(x => x.p.cat === ci)
      .map(x => `<div class="ovcard" style="--sc:${catColor(c)}" data-pi="${x.pi}">
        <div class="n">#${x.p.noPad}</div>
        <div class="t">${esc(x.p.titleZh)}</div>
      </div>`).join("");
    return `<div class="ovg">
      <div class="ovgh" style="--sc:${catColor(c)}" data-goto="${catSlideIdx[ci]}">
        <span class="mc">${esc(c.mnemonic)}</span>
        <span class="nm">${esc(c.name)}</span>
        <span class="rng">${c.count} 篇 · 第 ${esc(c.range)} 篇</span>
      </div>
      <div class="ovgrid">${cards}</div>
    </div>`;
  }).join("");
}
function openOv(){
  document.querySelectorAll("#ov .ovcard").forEach(card =>
    card.classList.toggle("cur", +card.dataset.pi === curPi));
  $("ov").classList.add("open");
  $("ov").scrollTop = 0;
}
function closeOv(){ $("ov").classList.remove("open"); }

/* ---------- 导航 ---------- */
function go(i){
  i = Math.max(0, Math.min(slides.length - 1, i));
  if (i === cur) return;
  cur = i;
  render();
}

/* ---------- 计时器 ---------- */
function fmtT(s){ return String(Math.floor(s/60)).padStart(2,"0") + ":" + String(s%60).padStart(2,"0"); }
function toggleTimer(){
  if (tRun){ clearInterval(tInt); tRun = false; return; }
  tRun = true;
  $("tchip").hidden = false;
  $("tchip").textContent = "⏱ " + fmtT(tSec);
  tInt = setInterval(() => { tSec++; $("tchip").textContent = "⏱ " + fmtT(tSec); }, 1000);
}
function resetTimer(){ clearInterval(tInt); tRun = false; tSec = 0; $("tchip").hidden = true; }

/* ---------- 事件 ---------- */
document.addEventListener("keydown", e => {
  if (e.ctrlKey || e.metaKey || e.altKey) return;
  if ($("ov").classList.contains("open")){
    if (e.key === "Escape" || e.key === "g" || e.key === "G") closeOv();
    e.preventDefault(); return;
  }
  switch (e.key){
    case "ArrowRight": case " ": case "PageDown": case "n": case "N":
      go(cur + 1); e.preventDefault(); break;
    case "ArrowLeft": case "PageUp": case "p": case "P":
      go(cur - 1); e.preventDefault(); break;
    case "ArrowDown": case "d": case "D":
      if (slides[cur].t === "paper") toggleDrawer();
      e.preventDefault(); break;
    case "ArrowUp":
      if (drawerOpen) closeDrawer();
      e.preventDefault(); break;
    case "g": case "G": openOv(); break;
    case "f": case "F":
      document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen();
      break;
    case "t": case "T": toggleTimer(); break;
    case "r": case "R": resetTimer(); break;
    case "Home": go(0); break;
    case "End": go(slides.length - 1); break;
    case "Escape": if (drawerOpen) closeDrawer(); break;
    default:
      if (/^[1-6]$/.test(e.key)) go(catSlideIdx[+e.key - 1]);
  }
});

$("stage").addEventListener("click", e => {
  if ($("ov").classList.contains("open")) return;
  if (e.target.closest("button, a, .no-nav")) return;
  if (drawerOpen){ closeDrawer(); return; } // 抽屉开着时，点抽屉外区域 = 收起
  go(e.clientX > window.innerWidth * 0.5 ? cur + 1 : cur - 1);
});

$("stage").addEventListener("click", e => {
  const b = e.target.closest("[data-goto]");
  if (b) go(+b.dataset.goto);
});

$("btnPrev").addEventListener("click", () => go(cur - 1));
$("btnNext").addEventListener("click", () => go(cur + 1));
$("btnOv").addEventListener("click", openOv);
$("ovClose").addEventListener("click", closeOv);
$("dClose").addEventListener("click", closeDrawer);
$("tabZh").addEventListener("click", () => setAbsTab("zh"));
$("tabEn").addEventListener("click", () => setAbsTab("en"));
$("btnFs").addEventListener("click", () =>
  document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen());

const themeBtn = $("btnTheme");
function applyTheme(dark){
  document.documentElement.dataset.theme = dark ? "dark" : "";
  themeBtn.textContent = dark ? "☀️ 浅色" : "🌙 深色";
  try { localStorage.setItem("fse-theme", dark ? "dark" : "light"); } catch(_){}
}
themeBtn.addEventListener("click", () =>
  applyTheme(document.documentElement.dataset.theme !== "dark"));
try { applyTheme(localStorage.getItem("fse-theme") === "dark"); } catch(_){}

$("ovBody").addEventListener("click", e => {
  const card = e.target.closest(".ovcard");
  if (card){ closeOv(); go(paperSlideIdx[+card.dataset.pi]); return; }
  const gh = e.target.closest(".ovgh");
  if (gh){ closeOv(); go(+gh.dataset.goto); }
});

/* ---------- 启动 ---------- */
(async function(){
  if (!await load()) return;
  buildSlides();
  initFooter();
  buildOv();
  document.body.classList.remove("booting");
  render();
})();
})();
</script>
</body>
</html>
